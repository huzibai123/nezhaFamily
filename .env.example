# 哪吒家庭 - 环境变量配置模板（给 docker-compose 使用）
# 使用方法：复制此文件为 .env 并填写实际值
# 命令：cp .env.example .env

# ====== 数据库配置 ======
# PostgreSQL 数据库名称
POSTGRES_DB=nezha_family
# PostgreSQL 用户名
POSTGRES_USER=nezha_user
# PostgreSQL 密码（生产环境必须修改为强密码：至少16位，包含大小写字母数字特殊字符）
POSTGRES_PASSWORD=请修改为强密码

# ====== Redis 配置 ======
# Redis 密码（生产环境必须修改为强密码：至少16位）
# docker-compose 会用这个密码同时配置 Redis 服务、后端和 Celery。
REDIS_PASSWORD=请修改为强密码

# ====== JWT 配置 ======
# JWT 密钥，用于签名 token（生产环境必须修改）
# 生成方式：openssl rand -hex 32
SECRET_KEY=请修改为随机密钥
# AI 模型供应商数据库 Key 的独立加密密钥。必须长期稳定，不要随 JWT SECRET_KEY 轮换。
# 生成方式：openssl rand -hex 32
AI_KEY_ENCRYPTION_SECRET=请修改为独立随机密钥
# JWT 签名算法（默认 HS256，通常无需修改）
ALGORITHM=HS256
# Token 过期时间（分钟），生产默认 1 小时
ACCESS_TOKEN_EXPIRE_MINUTES=60

# 数据库连接池配置
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# ====== 应用配置 ======
# 调试模式（开发环境 true，生产环境 false）
# 影响：SQL 日志输出、详细错误信息等
DEBUG=false

# 运行环境标识（development / production）
ENVIRONMENT=production

# 可信反向代理层数。默认生产 Caddy -> backend 为 1 层。
TRUSTED_PROXY_COUNT=1

# 生产环境域名（不包含 http/https 前缀）
# 例如：nezha.example.com
DOMAIN=your-domain.com

# 管理员邮箱（用于 Let's Encrypt HTTPS 证书申请和续期通知）
ADMIN_EMAIL=your-email@example.com

# 允许的跨域来源（CORS），多个用逗号分隔
# 开发环境示例：http://localhost:3000,http://localhost:5173
# 生产环境示例：https://your-domain.com
ALLOWED_ORIGINS=https://your-domain.com

# ====== 文件上传配置 ======
# 最大上传文件大小（字节）
# 100MB = 104857600，根据实际需求调整
MAX_UPLOAD_SIZE=104857600

# ====== AI 家庭管家配置（默认关闭）======
# 可选默认 API Key；也可以在后台管理页单独配置供应商密钥
AI_API_KEY=
# 默认 OpenAI-compatible 接口配置，可替换为 DeepSeek 官方或中转站
AI_DEFAULT_BASE_URL=https://api.openai.com/v1
AI_DEFAULT_TEXT_MODEL=gpt-4o-mini
AI_DEFAULT_VISION_MODEL=
AI_ENABLED=false
AI_REQUEST_TIMEOUT_SECONDS=30
AI_FAILURE_THRESHOLD=3

# ====== Celery 任务运行时配置 ======
# 全局任务硬/软超时（秒），避免 worker 被长任务无限占用。
CELERY_TASK_TIME_LIMIT=600
CELERY_TASK_SOFT_TIME_LIMIT=540
# 每个 worker 进程一次只预取一个任务，降低大文件/AI 任务造成的饥饿。
CELERY_WORKER_PREFETCH_MULTIPLIER=1
# 图片处理任务保留重试，并使用较长超时。
CELERY_IMAGE_TASK_TIME_LIMIT=600
CELERY_IMAGE_TASK_SOFT_TIME_LIMIT=540
# AI 任务默认不自动重试，但仍受超时约束。
CELERY_AI_TASK_TIME_LIMIT=180
CELERY_AI_TASK_SOFT_TIME_LIMIT=150
# 媒体回收站清理可能扫描较多文件，单独给更长但有限的超时。
CELERY_MEDIA_CLEANUP_TASK_TIME_LIMIT=3600
CELERY_MEDIA_CLEANUP_TASK_SOFT_TIME_LIMIT=3300

# ====== 可选配置 ======
# 时区设置
TZ=Asia/Shanghai

# 应用日志级别（开发：DEBUG，生产：WARNING 或 ERROR）
LOG_LEVEL=WARNING
