# 哪吒家庭后端 - 环境变量配置模板（给后端进程使用）
# 使用方法：复制此文件为 .env 并填写实际值
# 命令：cd backend && cp .env.example .env

# ===========================================
# 数据库配置
# ===========================================
# Docker 容器内使用（主机名为 docker-compose 服务名 postgres）
DATABASE_URL=postgresql+asyncpg://nezha_user:your_password@postgres:5432/nezha_family

# 本地开发直接运行后端时使用（主机名为 localhost）
# DATABASE_URL=postgresql+asyncpg://nezha_user:your_password@localhost:5432/nezha_family

# ===========================================
# Redis 配置
# ===========================================
# Docker 容器内使用
REDIS_URL=redis://:your_redis_password@redis:6379/0

# 本地开发直接运行后端时使用
# REDIS_URL=redis://:your_redis_password@localhost:6379/0

# ===========================================
# JWT 认证配置
# ===========================================
# JWT 密钥，用于签名 token（生产环境必须修改为强随机密钥）
# 生成方式：openssl rand -hex 32
SECRET_KEY=dev_secret_key_change_in_production
ALGORITHM=HS256
# Token 过期时间（分钟），默认 7 天 = 10080 分钟
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===========================================
# 应用配置
# ===========================================
# 调试模式（开发环境 true，生产环境 false）
# 影响：SQL 日志打印、详细错误堆栈等
DEBUG=true

# 允许的跨域来源（CORS），多个用逗号分隔
# 开发环境示例
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# 生产环境示例
# ALLOWED_ORIGINS=https://your-domain.com

# 应用运行环境标识
ENVIRONMENT=development

# ===========================================
# 文件存储配置
# ===========================================
# 媒体文件存储根目录（Docker 内通常为 /app/media，本地开发可用 ./media）
MEDIA_ROOT=/app/media
# 最大上传文件大小（字节），100MB = 104857600
MAX_UPLOAD_SIZE=104857600
# 允许的文件扩展名（逗号分隔）
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,gif,webp
ALLOWED_VIDEO_EXTENSIONS=mp4,mov,avi

# ===========================================
# Celery 任务队列配置
# ===========================================
CELERY_BROKER_URL=redis://:your_redis_password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:your_redis_password@redis:6379/2

# ===========================================
# 邀请码配置
# ===========================================
INVITE_CODE_LENGTH=8
INVITE_CODE_EXPIRES_DAYS=30

# ===========================================
# 注意事项
# ===========================================
# 1. 本地开发时，DATABASE_URL 和 REDIS_URL 的主机名需改为 localhost
# 2. Docker 容器内运行时，主机名使用 docker-compose.yml 中的服务名（postgres/redis）
# 3. 生产部署前必须修改 SECRET_KEY、数据库密码、Redis 密码
# 4. 密码强度要求：至少 16 位，包含大小写字母、数字和特殊字符
